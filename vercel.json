{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "python3 scripts/build_static.py",
  "outputDirectory": "public",
  "functions": {
    "api/index.py": {
      "maxDuration": 30,
      "includeFiles": "{server.py,postgres_store.py,lesson-video.json}"
    }
  },
  "rewrites": [{"source": "/api/:path*", "destination": "/api/index.py"}]
}
